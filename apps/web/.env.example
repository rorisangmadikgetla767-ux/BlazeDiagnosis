# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blaze_pos"

# App URL
APP_URL="http://localhost:3000"



# Vehicle lookup providers
VIN_DECODER_API_KEY=""
SA_VEHICLE_LOOKUP_API_KEY=""
MANUAL_VEHICLE_CATALOG_ENABLED="false"

# Parts fitment providers
SA_PARTS_FITMENT_API_KEY=""
MANUAL_PARTS_CATALOG_ENABLED="false"

# File Storage
UPLOAD_STORAGE_DRIVER="local"

# Data Base URL
env: {
    AUTH0_DOMAIN: 'test.auth0.com',
    AUTH0_AUDIENCE: 'https://test-api',
    DATABASE_URL: 'postgresql://test:test@localhost:5432/test',
}